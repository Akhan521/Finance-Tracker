# Local Edge Function env: copy to .env (git-ignored). CI copies this file.
# Everything here is non-secret and local only. Production values live in
# Supabase secrets, never in this repo.
ALLOWED_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
MAIL_FROM_NAME=Bills

# Mailpit (the supabase_inbucket container, alias `inbucket`): plain SMTP on
# 1025, no TLS. The alias is used because Deno cannot resolve names with
# underscores.
# SMTP_ALLOW_PLAINTEXT only takes effect for local host names.
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_ALLOW_PLAINTEXT=true
SMTP_USER=bills@localhost
SMTP_PASS=local-dummy
